<Window x:Class="cw3_galeria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw3_galeria"
        mc:Ignorable="d" ResizeMode="NoResize"
        Title="MainWindow" Height="800" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label  VerticalAlignment="Top" Padding="10"
                Grid.Row="0"
                Background="Beige"
                Foreground="#514567"
                FontWeight="Bold"
               FontSize="20"
               HorizontalContentAlignment="Center">Galeria zdjęć</Label>
        <Image x:Name="ImageControl" Grid.Row="1" 
               Grid.Column="0" Stretch="Uniform" Margin="10"/>
        <Button
            FontSize="16" FontWeight="Bold"
            x:Name="btnRandom" Grid.Row="2" Grid.Column="0" 
                Padding="10" Click="GetRandomImage">Wylosuj obrazek</Button>
        <Grid Grid.Row="3" Grid.Column="0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button FontSize="16" FontWeight="Bold"
                x:Name="btnPrev" Grid.Column="0" Padding="10" Click="Btn_Prev">&lt;&lt;</Button>
            <Button
                FontSize="16" FontWeight="Bold"
                x:Name="btnNext" Grid.Column="1" Padding="10" Click="BtnNext">&gt;&gt;</Button>
        </Grid>
    </Grid>
</Window>
