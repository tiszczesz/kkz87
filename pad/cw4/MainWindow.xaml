<Window x:Class="cw4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw4"
        mc:Ignorable="d"
        Title="Okno główne" Height="300" Width="500">
    <Canvas>
        <Button x:Name="showDateButton" Content="Pokaż datę" Click="showDateButton_Click"
                Canvas.Left="10" Canvas.Top="10" HorizontalAlignment="Left" 
                VerticalAlignment="Center" Width="146"/>
        <Label x:Name="dateLabel" Padding="4" Content="Label" Canvas.Left="170" 
               Canvas.Top="8" HorizontalAlignment="Center" Height="22" 
               VerticalAlignment="Top" />
        <Button x:Name="changeColorBtn" Content="Zmień kolor" Click="Change_color"
            Canvas.Left="10" Canvas.Top="44" Width="146" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button x:Name="showDateButton_Copy" Content="Pokaż datę" Click="showDateButton_Click"
            Canvas.Left="10" Canvas.Top="10" Width="146" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Rectangle x:Name="colorRectangle" Height="100" Canvas.Left="10" Stroke="Black" Canvas.Top="76" Width="100" HorizontalAlignment="Center" VerticalAlignment="Center" RadiusX="7" RadiusY="7" />
        <TextBox x:Name="textBox" Canvas.Left="176" TextWrapping="Wrap" Text=""
                 Canvas.Top="46" Width="120" />
        <Button Content="Pokaż" Canvas.Left="311" Canvas.Top="44" HorizontalAlignment="Left" VerticalAlignment="Top" Width="98" Click="Button_Click"/>

    </Canvas>
</Window>
