<Window x:Class="ark_gory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ark_gory"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        Title="Wyjazd w góry" Height="600" Width="350">
    <StackPanel Orientation="Vertical" Margin="0,20,0,0">
        <TextBlock FontSize="32" Foreground="DarkGray">
            Domek w górach
        </TextBlock>
        <Image Height="Auto" Width="Auto" Source="/obraz.jpg"/>
        <!-- 
        <StackPanel Orientation="Horizontal">
            <Button Width="117">POLUB</Button>
            <Button Width="117">USUŃ</Button>
            <Button Width="117">ZAPISZ”</Button>
        </StackPanel>
        -->
        <Grid Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Background="#008080"
                Foreground="White"
                Grid.Column="0" Content="POLUB" Click="btnAddLikes"/>

            <Button 
                Background="#008080" 
                Foreground="White"
                Grid.Column="1" Click="BtnResetLikes" >USUŃ
            </Button>
            <Button 
                Background="#008080" 
                Foreground="White"
                Grid.Column="2" Click="BtnSaveLikes" >ZAPISZ
            </Button>
        </Grid>
        <TextBlock x:Name="countLikes" 
            FontSize="16" Foreground="DarkGray"
            TextAlignment="Right"></TextBlock>
        <Separator Margin="0,10" Background="Gray" Height="1" />
        <TextBlock FontWeight="Bold" FontSize="16" Foreground="DarkGray"
            TextAlignment="Left">Opis</TextBlock>
        <TextBlock FontSize="16" Foreground="DarkGray"                   
                TextAlignment="Left" TextWrapping="Wrap">
            Odwiedź komfortowy domek w Sudetach, blisko do szlaków turystycznych
        </TextBlock>
    </StackPanel>
</Window>
