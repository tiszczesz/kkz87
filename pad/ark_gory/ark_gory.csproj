    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="obraz.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="obraz.jpg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="counter.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
