<Window x:Name="SecondWin" x:Class="cw2_wpf.SecondWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw2_wpf"
        mc:Ignorable="d"
        
        Title="SecondWindow" Height="300" Width="400" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <StackPanel Orientation="Vertical">
        <Button>Pokaż datę</Button>
        <Label x:Name="LblDate" Content="Data" Height="100" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Center"
               FontSize="30"/>
        <Button Click="Button_Click">Zamknij</Button>
    </StackPanel>
</Window>
