<Window x:Name="MyOtherWindow" x:Class="cw2_wpf.OtherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw2_wpf"
        mc:Ignorable="d"
        Title="OtherWindow" Height="450" Width="800" 
        ResizeMode="NoResize" 
        WindowStyle="ToolWindow" 
        Loaded="MyOtherWindow_Loaded">
    <StackPanel Orientation="Vertical">
        <Label
            x:Name="lblShowTime"
            Content="Label"  Margin="0" 
               HorizontalContentAlignment="Center"
               FontSize="30"
               Padding="30"
              />
        <Button x:Name="BtnStopTimer" Click="BtnStopTimer_Click">Zatrzymaj Zegar</Button>
    
    </StackPanel>
</Window>
