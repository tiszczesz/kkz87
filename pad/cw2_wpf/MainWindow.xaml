<Window x:Class="cw2_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw2_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid HorizontalAlignment="Right" Width="800">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="118*"/>
        </Grid.RowDefinitions>
        <Button x:Name="BtnNewWindow" Grid.Row="0" Content="Click me"
                Height="50" Click="ShowNewWindow"/>
        <Button x:Name="BtnShowSecondWindow" Grid.Row="1" Content="Pokaż nowe okno"
          Height="50" Click="BtnShowSecondWindow_Click" />
        <Button x:Name="BtnShowOtherWindow" Grid.Row="2" Content="Pokaż nowe okno z czasem"
  Height="50" Click="BtnShowSecondWindow_Click" />
    </Grid>
</Window>
